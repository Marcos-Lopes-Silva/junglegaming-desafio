{
  "name": "jungle-wagering",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --watch apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck",
    "lint": "eslint \"{apps,packages,test,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"{apps,packages,test,scripts}/**/*.ts\"",
    "test": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "test:integration": "bun scripts/integration.ts",
    "migration:up": "bun scripts/migrate.ts up",
    "migration:down": "bun scripts/migrate.ts down",
    "migration:list": "bun scripts/migrate.ts list",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down -v",
    "dev:worker": "bun --watch apps/worker/src/main.ts",
    "test:load": "bun test/load/run.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
