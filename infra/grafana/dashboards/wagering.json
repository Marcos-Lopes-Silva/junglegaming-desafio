{
  "uid": "wagering-overview",
  "title": "Wagering — visão geral",
  "tags": ["wagering"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Transações por status",
      "description": "Taxa de transações aplicadas, rejeitadas e pendentes de referência.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(wager_transactions_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Transações por tipo",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (kind) (rate(wager_transactions_total[1m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência de processamento",
      "description": "p50, p95 e p99 por origem (http, sqs, pending-reference).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, source) (rate(processing_latency_seconds_bucket[1m])))",
          "legendFormat": "p50 {{source}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(processing_latency_seconds_bucket[1m])))",
          "legendFormat": "p95 {{source}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, source) (rate(processing_latency_seconds_bucket[1m])))",
          "legendFormat": "p99 {{source}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox lag",
      "description": "Idade da mensagem pendente mais antiga. Subir de forma sustentada significa que o publisher não está dando conta.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "max(outbox_lag_seconds)", "legendFormat": "lag", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Duplicatas e replays",
      "description": "Entrega at-least-once em ação: duplicatas barradas pelo inbox e requisições atendidas como replay.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(inbox_duplicates_total[1m]))",
          "legendFormat": "duplicatas de inbox",
          "refId": "A"
        },
        {
          "expr": "sum(rate(idempotent_replays_total[1m]))",
          "legendFormat": "replays idempotentes",
          "refId": "B"
        },
        {
          "expr": "sum(rate(idempotency_conflicts_total[1m]))",
          "legendFormat": "conflitos de idempotência",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Retries por estágio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (stage) (rate(retries_total[1m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Mensagens em DLQ",
      "description": "Qualquer valor acima de zero merece investigação: é payload que o sistema não conseguiu interpretar.",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(dlq_messages_total)", "legendFormat": "total", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Divergências de reconciliação",
      "description": "Saldo materializado diferente do reconstruído pelo ledger. Precisa ser sempre zero.",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(reconciliations_total{result=\"divergent\"})",
          "legendFormat": "divergentes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Wallets abertas",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "expr": "sum(wallets_opened_total)", "legendFormat": "total", "refId": "A" }
      ]
    }
  ]
}
