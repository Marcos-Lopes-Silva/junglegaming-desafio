{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "bun"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@wagering/domain": ["packages/domain/src/index.ts"],
      "@wagering/domain/*": ["packages/domain/src/*"],
      "@wagering/application": ["packages/application/src/index.ts"],
      "@wagering/application/*": ["packages/application/src/*"],
      "@wagering/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@wagering/infrastructure/*": ["packages/infrastructure/src/*"],
      "@wagering/wiring": ["packages/wiring/src/index.ts"],
      "@wagering/wiring/*": ["packages/wiring/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
}
